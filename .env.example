# ---------------------------------------------------------------------------
# Copy this file to a new file named ".env" and fill in your real values.
# The .env file is git-ignored, so your secret key never gets committed.
# On a host like Render, you set these same names in the dashboard instead of
# using a file.
# ---------------------------------------------------------------------------

# REQUIRED: your Anthropic API key (starts with "sk-ant-").
# Get one at https://console.anthropic.com  ->  Settings  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# OPTIONAL: which model does the drafting. Default is claude-sonnet-5.
# Cheapest: claude-haiku-4-5-20251001   Highest quality: claude-opus-5
MODEL=claude-sonnet-5

# OPTIONAL but recommended for a public URL: a shared password your fellows
# must type before they can generate a draft. This protects your API key from
# strangers running up a bill. Leave blank to disable the gate.
ACCESS_CODE=

# OPTIONAL: team code for the observer rules-check feature. When set, an
# observer must enter this shared code (under Setup) before the "Check the
# rules" button will work. Keeps that paid AI endpoint off the open internet.
TEAM_CODE=

# OPTIONAL: which model powers the rules-check. Default is Haiku (cheap + fast).
# Set to claude-sonnet-5 to test higher quality and measure real cost.
CHECK_MODEL=claude-haiku-4-5-20251001

# OPTIONAL: central collection. The web-app URL of the Google Apps Script that
# writes to your shared Google Sheet (ends in /exec). When set, observers'
# "Submit to team" button pushes their observations into that sheet. Leave
# blank to disable central collection. See README, "Central collection".
SHEET_WEBHOOK_URL=

# OPTIONAL: drafter read-back. A shared secret that MUST match the READ_TOKEN
# value inside your Apps Script. When set (with SHEET_WEBHOOK_URL), a drafter's
# "Load from team repo" button can pull the team's observations back out of the
# Sheet. Leave blank to keep the repo write-only.
SHEET_READ_TOKEN=

# OPTIONAL: photo storage (Cloudflare R2). All four must be set for photo
# uploads to work; /health shows "photoStorage": true when they are. Find them
# in the Cloudflare dashboard -> R2 Object Storage. The SECRET is shown only once,
# when you create the API token — store it here and in Render, nowhere else.
#   R2_ACCOUNT_ID         the long hex ID on the R2 overview page
#   R2_ACCESS_KEY_ID      from the R2 API token (think: username)
#   R2_SECRET_ACCESS_KEY  from the R2 API token (think: password)
#   R2_BUCKET             the bucket name, e.g. observer-photos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=observer-photos

# OPTIONAL: team chat capture (Telegram). The bot pushes every message in the
# team group to /api/chat-hook; the server records it on the Sheet's "Chat"
# tab (NEVER the observation sheet). Full steps: README, "Team chat".
#   TELEGRAM_BOT_TOKEN       from @BotFather. LOCAL ONLY — used by
#                            tools/telegram-setup.js. Render doesn't need it.
#   TELEGRAM_WEBHOOK_SECRET  make one: node tools/telegram-setup.js secret
#                            Same value here AND on Render.
#   TELEGRAM_CHAT_IDS        the team group's chat ID (negative number, keep
#                            the minus). Comma-separate several. Messages from
#                            any other chat are ignored.
#   TEAM_CHAT_URL            the group's invite link (https://t.me/+...). The
#                            app's "Team chat" button hands it out — only to
#                            someone with the team code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_IDS=
TEAM_CHAT_URL=

# OPTIONAL: the port the server listens on locally. Hosts set this for you.
PORT=3000
